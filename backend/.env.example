# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (use Atlas, not self-hosted — see architecture doc).
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/finportal?retryWrites=true&w=majority

# --- Sensitive-data keys (32 bytes, base64). Generate with:  npm run keygen ---
# In production these come from a KMS / secrets manager, NOT this file.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Admin auth ---
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-different-long-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Applicant magic-link resume tokens ---
RESUME_TOKEN_SECRET=change-me-long-random
RESUME_TOKEN_TTL_HOURS=72

# --- CAPTCHA (Cloudflare Turnstile). Leave blank in dev to skip; REQUIRED in production. ---
TURNSTILE_SECRET=

# --- Retention & consent ---
DRAFT_RETENTION_DAYS=30
PRIVACY_NOTICE_VERSION=2026-01

# --- S3 (private bucket). Credentials come from the IAM role or standard AWS env chain. ---
AWS_REGION=
S3_BUCKET=
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=120

# Shared secret the virus scanner presents (x-scan-secret header) on its callback.
SCAN_CALLBACK_SECRET=change-me-long-random

# Run the retention purge inside this process (small deploys). Prefer external cron in prod.
ENABLE_PURGE_CRON=false

# Public URL of the frontend (used to build resume links in emails).
APP_BASE_URL=http://localhost:3000

# --- Email (SMTP). Leave SMTP_HOST blank in dev to log emails to the console instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@finportal.example
