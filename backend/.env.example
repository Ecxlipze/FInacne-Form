# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (use Atlas, not self-hosted — see architecture doc).
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/finportal?retryWrites=true&w=majority

# --- Sensitive-data keys (32 bytes, base64). Generate with:  npm run keygen ---
# In production these come from a KMS / secrets manager, NOT this file.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Admin auth ---
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-different-long-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Applicant magic-link resume tokens ---
RESUME_TOKEN_SECRET=change-me-long-random
RESUME_TOKEN_TTL_HOURS=72
